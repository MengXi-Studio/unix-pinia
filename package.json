{
	"name": "unix-pinia",
	"type": "module",
	"version": "0.2.0",
	"private": true,
	"description": "为 uni-app x 提供 Pinia 风格的状态管理与内置持久化（UTS 编写，class + reactive 架构）",
	"packageManager": "pnpm@10.31.0",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"sync:uni-modules": "node scripts/sync-uni-modules.mjs",
		"sync:uni-modules:check": "node scripts/sync-uni-modules.mjs --check",
		"dev:docs": "pnpm --filter @meng-xi/unix-pinia-docs dev",
		"build:docs": "pnpm --filter @meng-xi/unix-pinia-docs build",
		"preview:docs": "pnpm --filter @meng-xi/unix-pinia-docs preview",
		"release": "bumpp",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"bumpp": "^12.3.0",
		"prettier": "^3.8.1",
		"typescript": "^5.9.3"
	},
	"author": {
		"name": "PedroQue99",
		"email": "ksmengfang@163.com"
	},
	"license": "MIT",
	"homepage": "https://github.com/MengXi-Studio/unix-pinia#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MengXi-Studio/unix-pinia.git"
	},
	"bugs": "https://github.com/MengXi-Studio/unix-pinia/issues"
}
