/**
 * unix-pinia 入口：统一导出公开 API
 *
 * 创建与实例：createPinia / Pinia / setActivePinia / getActivePinia
 * 定义与使用：defineStore / storeToRefs
 * 实例 API（$-methods 顶层映射）：patch / dispose / getStoreId
 *
 * subscribe 已裁掉（P9 裁决：Android 端 deep watch 对 RefImpl 字段不触发，
 * 双端行为不一致；替代模式：字段级 watch(store.count, cb)，差异表已标注）
 */
export { createPinia, Pinia, setActivePinia, getActivePinia } from './pinia.uts'
export type { PiniaPlugin, PiniaPluginContext } from './pinia.uts'
export { defineStore } from './defineStore.uts'
export { storeToRefs } from './storeToRefs.uts'
export { patch, dispose, getStoreId } from './instanceApi.uts'
export type { Unsubscribe, SubscribeCallback } from './interface.uts'
