/**
 * 持久化存储层（实现层，纯存储原语——零 vue 符号）
 *
 * JSON 信封序列化（{ v: 值 }）——规避 uni storage 未命中返回空串与合法空值
 * 的歧义，损坏数据 parse 失败由调用方回退默认值；后端可经 setStorageAdapterImpl 替换。
 *
 * 归属说明（0.2.0 合并）：原独立包 @meng-xi/unix-pinia-persist（ux-pinia-persist）
 * 经 HBuilderX 5.34 编译器实证重构为纯存储原语（UTS 插件内 vue 符号的 Kotlin import
 * 生成失效），失去插件形态后并入 core——持久化是状态管理的伴生能力，单包交付。
 * 响应式接入（ref 创建 / watch 落盘）由使用方在 store setup（主工程编译路径）组合，
 * 推荐主工程侧封装 persistedRef 辅助函数（示例工程 stores/persist-helper.uts）。
 *
 * Kotlin 红线（云打包 release 实证，HBuilderX 5.34）：
 * - 零 vue 符号：vue 符号的 Kotlin import 生成失效，插件内保持零 vue 依赖
 * - uni.getStorageSync 返回 Any?：any 声明必须带 | null
 * - 适配器 lambda 内不做单步 Any?→String? 强转，分步显式标注
 * - 函数作值必须箭头 const 表达式（function 声明不能作值传递）
 */
import type { StorageAdapter } from '../interface.uts'

/** 键前缀：与其它存储使用方隔离 */
export const PERSIST_KEY_PREFIX = 'ux-pinia-persist:'

/** 默认读取：uni storage（未命中返回空串），归一为 string | null */
const defaultGet = (key: string): string | null => {
	// getStorageSync 返回 Any?：any 声明必须带 | null（Kotlin 端 Any? 赋非空 Any 编译报错）
	const raw: any | null = uni.getStorageSync(key)
	if (raw == null) {
		return null
	}
	const text: string = raw as string
	if (text.length == 0) {
		return null
	}
	return text
}

/** 默认写入：uni storage */
const defaultSet = (key: string, value: string): void => {
	uni.setStorageSync(key, value as any)
}

/** 当前存储适配器（默认 uni storage，可经 setStorageAdapterImpl 替换） */
let adapter: StorageAdapter = { get: defaultGet, set: defaultSet }

/** 替换存储后端（实现「使用者自选持久化库」：unix-storage / 原生 preferences 等） */
export function setStorageAdapterImpl(next: StorageAdapter): void {
	adapter = next
}

/** 信封类型：{ v: 值 } */
type PersistEnvelope = {
	v: any
}

/** 组完整存储键 */
export function storageKeyOf(storeId: string, key: string): string {
	return PERSIST_KEY_PREFIX + storeId + '.' + key
}

/** 从存储读取持久化值；未命中或损坏返回 null（调用方回退默认值）。泛型边界以 any 承载 */
export function loadValue(storeId: string, key: string): any | null {
	// adapter.get 经对象字面量桥接后 Kotlin 端表达式类型为 Any?：先以 any | null 承载，再显式收窄 string
	const rawAny: any | null = adapter.get(storageKeyOf(storeId, key))
	if (rawAny == null) {
		return null
	}
	const raw: string = rawAny as string
	const parsed: any | null = JSON.parse(raw)
	const envelope: PersistEnvelope | null = parsed as PersistEnvelope | null
	if (envelope == null) {
		return null
	}
	return envelope.v
}

/** 写入持久化值（JSON 信封） */
export function saveValue(storeId: string, key: string, value: any): void {
	const envelope: PersistEnvelope = { v: value }
	adapter.set(storageKeyOf(storeId, key), JSON.stringify(envelope))
}
