/**
 * Pinia 实例与插件体系（一比一对齐 createPinia / pinia.use / app.use(pinia)）
 *
 * UTS 约束：插件不能返回对象合并进 store（禁止动态注入属性），PiniaPlugin 返回 void，
 * 插件逻辑通过 PiniaPluginContext 完成（监听/记录等，x-pinia-s 同款约束）。
 */

/** 插件上下文：对齐 Pinia 的 { pinia, store, storeId } 三字段 */
export type PiniaPluginContext = {
  pinia: Pinia,
  store: any,
  storeId: string
}

/** 插件函数类型：返回 void（UTS 约束）。注意 UTS 函数类型必须用箭头语法 */
export type PiniaPlugin = (ctx: PiniaPluginContext) => void

/**
 * Pinia 实例。
 * 说明：uni-app x 应用无多实例隔离场景，store 全局唯一注册表（差异表已注明）；
 * Pinia 实例承载插件列表与 active 标记。
 */
export class Pinia {
  private plugins: Array<PiniaPlugin> = new Array<PiniaPlugin>()

  /** 注册插件（链式） */
  use(plugin: PiniaPlugin): Pinia {
    this.plugins.push(plugin)
    return this
  }

  /** app.use(pinia) 入口：登记为 active 实例（P8 验证项：vdom 原生端调用可达性） */
  install(app: any): void {
    setActivePinia(this)
    console.log('[unix-pinia] pinia install（app.use 挂载成功）')
  }

  /** 供 defineStore 在 store 创建后调度插件 */
  getPlugins(): Array<PiniaPlugin> {
    return this.plugins
  }
}

// 模块级 active 实例（UTS 顶层变量 = 静态成员）
let currentActive: Pinia | null = null

/** 创建 Pinia 实例（对齐标准 Pinia；v1 多实例共享同一 store 池） */
export function createPinia(): Pinia {
  return new Pinia()
}

export function setActivePinia(pinia: Pinia | null): void {
  currentActive = pinia
}

export function getActivePinia(): Pinia | null {
  return currentActive
}
