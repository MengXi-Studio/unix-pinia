<template>
	<view class="page">
		<demo-navbar title="实例 API" subtitle="Instance API" />
		<demo-bridge />
		<scroll-view class="page-body" :scroll-y="true">
		<view class="container">
			<view class="card">
				<text class="card-title">功能说明</text>
				<text class="card-desc">实例 API 由 PiniaStoreBase 基类提供（0.2.0 class 式）：$patch(partial UTSJSONObject) 经 _hydrate 装载局部数据、$id 反查 id、$dispose 注销实例（顶层 dispose 等价）、$save 显式保存点（触发 $subscribe 分发 type='save'）。dispose 后既有引用成为孤儿实例，本页使用独立测试 store 验证。进入页面自动运行。</text>
			</view>

			<view class="card">
				<text class="card-line">counter.count: {{ counterStore.state.count }}</text>
			</view>

			<text class="section">用例</text>
			<view class="row">
				<button class="row-btn" size="mini" @click="run">重新运行</button>
			</view>

			<view class="logs">
				<view class="logs-head">
					<text class="logs-title">运行日志（console 同步输出 [verify] 前缀日志）</text>
					<button class="row-btn" size="mini" @click="clearLog">清空</button>
				</view>
				<text v-for="(line, index) in logs" :key="index" class="log">{{ line }}</text>
			</view>
		</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	// 页面声明宏：编译期由 ux-router vite 插件剥离，驱动 pages.json 与路由表生成
	defineUniPage({
		title: '实例 API',
		name: 'instance-api'
	})
	import { ref } from 'vue'
	import { useCounterStore } from '@/stores/counter.uts'
	import { useDisposeTestStore } from '@/stores/probe.uts'
	import { mark, markEq } from '@/common/test-utils.uts'

	const counterStore = useCounterStore()

	const logs = ref<Array<string>>([])

	function log(msg: string): void {
		const line = '[verify] ' + msg
		logs.value.unshift(line)
		if (logs.value.length > 200) {
			logs.value.splice(200, logs.value.length - 200)
		}
		console.log(line)
	}

	function clearLog(): void {
		logs.value.splice(0, logs.value.length)
	}

	/** I1 实例 API */
	function run(): void {
		// I1-1 $patch：批量修改（partial UTSJSONObject，经 _hydrate 装载）
		counterStore.$patch({ count: 66 } as UTSJSONObject)
		log(markEq('I1-1 $patch 批量修改 count', counterStore.state.count, 66))

		// I1-2 $id：反查 id（顶层 getStoreId 等价）
		log(mark('I1-2 $id 反查', counterStore.$id == 'counter', "id='" + counterStore.$id + "'"))

		// I1-3 $dispose 后重建（独立 probe store，不污染 counter 注册表实例）
		const oldDs = useDisposeTestStore()
		oldDs.setValue(7)
		oldDs.$dispose()
		const newDs = useDisposeTestStore()
		const rebuilt = newDs != oldDs && newDs.state.value == 0
		log(mark('I1-3 $dispose 后重建', rebuilt, "新实例 value=0 id='" + newDs.$id + "'"))
		log('说明：dispose 后旧引用成为孤儿实例，仅用于应用级清理场景')

		// I1-4 $save：显式保存点（触发 $subscribe 分发 type='save'；direct 修改不触发）
		let saveNotified = false
		const unsub = counterStore.$subscribe((type: string, state: UTSJSONObject): void => {
			if (type == 'save') {
				saveNotified = true
			}
		})
		counterStore.$save()
		unsub()
		log(mark('I1-4 $save 触发订阅（type=save）', saveNotified, 'direct 修改不触发，需显式 $save'))
	}

	onMounted((): void => {
		run()
	})
</script>
