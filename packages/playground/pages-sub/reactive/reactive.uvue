<template>
	<view class="page">
		<demo-navbar title="响应式矩阵" subtitle="Reactive" />
		<demo-bridge />
		<scroll-view class="page-body" :scroll-y="true">
		<view class="container">
			<view class="card">
				<text class="card-title">功能说明</text>
				<text class="card-desc">0.3.0 class 式架构：store.state 本身就是 reactive&lt;T&gt; 强类型对象——脚本与模板同路径（counterStore.state.count）直接读写，修改即响应式更新。请勿再用 reactive() 包整个 store：UTS 无 Proxy，包装解包行为双端不一致，且 state 已内置 reactive 无此需求。进入页面自动运行。</text>
			</view>

			<view class="card">
				<text class="card-line">count: {{ counterStore.state.count }}</text>
				<text class="card-line">doubleCount: {{ counterStore.doubleCount }}</text>
				<text class="card-line">name: {{ counterStore.state.name }}</text>
			</view>

			<text class="section">用例</text>
			<view class="row">
				<button class="row-btn" size="mini" @click="run">重新运行</button>
				<button class="row-btn" size="mini" @click="incNum">count+1（direct 修改，观察联动）</button>
			</view>

			<view class="logs">
				<view class="logs-head">
					<text class="logs-title">运行日志（console 同步输出 [verify] 前缀日志）</text>
					<button class="row-btn" size="mini" @click="clearLog">清空</button>
				</view>
				<text v-for="(line, index) in logs" :key="index" class="log">{{ line }}</text>
			</view>
		</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	// 页面声明宏：编译期由 ux-router vite 插件剥离，驱动 pages.json 与路由表生成
	defineUniPage({
		title: '响应式矩阵',
		name: 'reactive'
	})
	import { ref } from 'vue'
	import { useCounterStore } from '@/stores/counter.uts'
	import { mark, markEq } from '@/common/test-utils.uts'

	const counterStore = useCounterStore()

	const logs = ref<Array<string>>([])

	function log(msg: string): void {
		const line = '[verify] ' + msg
		logs.value.unshift(line)
		if (logs.value.length > 200) {
			logs.value.splice(200, logs.value.length - 200)
		}
		console.log(line)
	}

	function clearLog(): void {
		logs.value.splice(0, logs.value.length)
	}

	const incNum = (): void => {
		// direct 修改 reactive 字段：模板 counterStore.state.count 自动联动
		counterStore.state.count++
	}

	/** R1 reactive state 直接修改的响应式 */
	function run(): void {
		counterStore.reset()
		// R1-1 direct 修改 reactive 字段（脚本与模板同路径，无 .value）
		counterStore.state.count = 11
		log(markEq('R1-1 direct 修改 state.count', counterStore.state.count, 11))
		log('R1-1 模板 counterStore.state.count 应同步显示 11（reactive 属性代理自动更新）')

		// R1-2 getter 派生值随 reactive 字段联动
		log(markEq('R1-2 getter doubleCount 联动', counterStore.doubleCount, 22))

		// R1-3 direct 修改与 action 修改可混合（同一 reactive state）
		counterStore.state.count++
		counterStore.increment()
		log(markEq('R1-3 direct++ 后 increment 累加', counterStore.state.count, 13))

		// R1-4 reactive 字符串字段 direct 修改
		counterStore.state.name = 'reactive'
		log(mark('R1-4 direct 修改 state.name', counterStore.state.name == 'reactive', "name='" + counterStore.state.name + "'"))

		// R1-5 红线说明：不再需要 reactive() 包装 store
		log('R1-5 说明：请勿再用 reactive() 包整个 store——store.state 已内置 reactive，0.2.0 的解包双端差异问题不复存在')
	}

	onMounted((): void => {
		run()
	})
</script>
