<template>
	<view class="page">
		<demo-navbar title="跨页面共享（断言）" subtitle="Cross Verify" />
		<demo-bridge />
		<scroll-view class="page-body" :scroll-y="true">
		<view class="container">
			<view class="card">
				<text class="card-title">跨页面共享 · 断言方</text>
				<text class="card-desc">本页 useCounterStore() 从注册表取实例：若与写入方为同一实例，count 应等于写入方离开时的值，且 doubleCount = count × 2。进入页面自动断言。</text>
			</view>

			<view class="card">
				<text class="card-line">count: {{ count }}</text>
				<text class="card-line">doubleCount: {{ doubleCount }}</text>
				<text class="card-line">{{ t1Result }}</text>
			</view>

			<view class="row">
				<button class="row-btn" size="mini" @click="onInc">increment（返回写入方后应联动）</button>
				<button class="row-btn" size="mini" @click="onBack">返回写入方</button>
			</view>
		</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	// 页面声明宏：编译期由 ux-router vite 插件剥离，驱动 pages.json 与路由表生成
	defineUniPage({
		title: '跨页面共享（断言）',
		name: 'cross-verify'
	})
	import { ref } from 'vue'
	import { storeToRefs } from '@/uni_modules/ux-pinia'
	import { useCounterStore } from '@/stores/counter.uts'
	import { getT1Expected } from '@/stores/testContext.uts'

	const secondStore = useCounterStore()
	const { count, doubleCount } = storeToRefs(secondStore)

	const t1Result = ref('T1 断言: 待判定')

	function assert(): void {
		const expected = getT1Expected()
		const actual = secondStore.count.value
		const pass = actual == expected && secondStore.doubleCount.value == actual * 2
		t1Result.value = 'T1 断言: ' + (pass ? 'pass（同一实例，状态与写入方一致）' : 'fail（actual=' + actual.toString() + ', expected=' + expected.toString() + '）')
		console.log('[verify] T1 verify page count = ' + actual.toString() + ' expected = ' + expected.toString() + ' => ' + (pass ? 'PASS' : 'FAIL'))
	}

	const onInc = (): void => {
		secondStore.increment()
	}

	const onBack = (): void => {
		uni.navigateBack()
	}

	onMounted((): void => {
		assert()
		// 演示跨页面修改：返回写入方后其视图应联动
		secondStore.increment()
		console.log('[verify] T1 verify page increment -> ' + secondStore.count.value.toString())
	})
</script>

