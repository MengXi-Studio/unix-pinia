<template>
	<view class="page">
		<demo-navbar title="插件与 Pinia 实例" subtitle="Plugin" />
		<demo-bridge />
		<scroll-view class="page-body" :scroll-y="true">
		<view class="container">
			<view class="card">
				<text class="card-title">功能说明</text>
				<text class="card-desc">createPinia 创建实例，setActivePinia 登记（main.uts 已顶层执行）；pinia.use 链式注册插件，store 首次创建时按序调度，PiniaPluginContext 携带 pinia / store / storeId。ctx.store 为 PiniaStoreBase 子类实例，as 收窄后可用 $subscribe / $onAction。进入页面自动运行。</text>
			</view>

			<text class="section">用例</text>
			<view class="row">
				<button class="row-btn" size="mini" @click="run">重新运行</button>
			</view>

			<view class="logs">
				<view class="logs-head">
					<text class="logs-title">运行日志（console 同步输出 [verify] 前缀日志）</text>
					<button class="row-btn" size="mini" @click="clearLog">清空</button>
				</view>
				<text v-for="(line, index) in logs" :key="index" class="log">{{ line }}</text>
			</view>
		</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	// 页面声明宏：编译期由 ux-router vite 插件剥离，驱动 pages.json 与路由表生成
	defineUniPage({
		title: '插件与 Pinia 实例',
		name: 'plugin'
	})
	import { ref } from 'vue'
	import type { PiniaPluginContext } from '@/uni_modules/ux-pinia'
	import { getActivePinia, PiniaStoreBase } from '@/uni_modules/ux-pinia'
	import { usePluginProbeStore } from '@/stores/probe.uts'

	const logs = ref<Array<string>>([])

	function log(msg: string): void {
		const line = '[verify] ' + msg
		logs.value.unshift(line)
		if (logs.value.length > 200) {
			logs.value.splice(200, logs.value.length - 200)
		}
		console.log(line)
	}

	function clearLog(): void {
		logs.value.splice(0, logs.value.length)
	}

	/** P8 插件与 Pinia 实例 */
	function run(): void {
		// P8-1 active 实例已由 main.uts 顶层登记
		const pinia = getActivePinia()
		log('P8-1 activePinia 已登记：' + (pinia != null ? 'pass' : 'FAIL（null）'))
		if (pinia == null) {
			return
		}

		// 先注销探针 store，保证本次 run 重新创建并调度插件
		const stale = usePluginProbeStore()
		stale.$dispose()

		// P8-2 插件调度：注册 logger 后创建新 store，插件应收到 ctx
		let receivedId = ''
		let receivedStore = false
		const logger = (ctx: PiniaPluginContext): void => {
			receivedId = ctx.storeId
			const base = ctx.store as PiniaStoreBase
			receivedStore = base instanceof PiniaStoreBase
		}

		// P8-4 链式 use（noop 插件演示链式返回实例本身）
		const noop = (ctx: PiniaPluginContext): void => {}
		const chained = pinia.use(noop).use(logger)
		log('P8-4 链式 use 返回实例本身：' + (chained != null ? 'pass' : 'FAIL'))

		// 触发创建（重新创建时调度插件）
		const probe = usePluginProbeStore()
		log('P8-2 插件调度收到 storeId：' + (receivedId == 'plugin-probe' ? "pass ('" + receivedId + "')" : "FAIL ('" + receivedId + "')"))
		log('P8-3 ctx.store 为 PiniaStoreBase 子类实例：' + (receivedStore ? 'pass' : 'FAIL'))
		log('说明：插件返回 void（UTS 禁止向 store 注入属性），扩展逻辑经 ctx.store as PiniaStoreBase 完成（$subscribe/$onAction）')
	}

	onMounted((): void => {
		run()
	})
</script>
