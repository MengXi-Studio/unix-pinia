<template>
	<view class="page">
		<demo-navbar title="单例与幂等" subtitle="Singleton" />
		<demo-bridge />
		<scroll-view class="page-body" :scroll-y="true">
		<view class="container">
			<view class="card">
				<text class="card-title">功能说明</text>
				<text class="card-desc">模块级注册表保证单例：同 id 多次 useStore 返回同一实例（跨页面共享的基础）；同 id 重复 defineStore 警告并保持幂等；不同 id 各自独立。进入页面自动运行。</text>
			</view>

			<text class="section">用例</text>
			<view class="row">
				<button class="row-btn" size="mini" @click="run">重新运行</button>
			</view>

			<view class="logs">
				<view class="logs-head">
					<text class="logs-title">运行日志（console 同步输出 [verify] 前缀日志）</text>
					<button class="row-btn" size="mini" @click="clearLog">清空</button>
				</view>
				<text v-for="(line, index) in logs" :key="index" class="log">{{ line }}</text>
			</view>
		</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	// 页面声明宏：编译期由 ux-router vite 插件剥离，驱动 pages.json 与路由表生成
	defineUniPage({
		title: '单例与幂等',
		name: 'singleton'
	})
	import { ref } from 'vue'
	import { defineStore, storeToRefs } from '@/uni_modules/ux-pinia'
	import { useCounterStore } from '@/stores/counter.uts'
	import type { CounterStore } from '@/stores/counter.uts'
	import { useUserStore } from '@/stores/user.uts'
	import { mark } from '@/common/test-utils.uts'

	const logs = ref<Array<string>>([])

	function log(msg: string): void {
		const line = '[verify] ' + msg
		logs.value.unshift(line)
		if (logs.value.length > 200) {
			logs.value.splice(200, logs.value.length - 200)
		}
		console.log(line)
	}

	function clearLog(): void {
		logs.value.splice(0, logs.value.length)
	}

	/** S1 单例与幂等 */
	function run(): void {
		// S1-1 同页多次 useStore：同一实例
		const a = useCounterStore()
		const b = useCounterStore()
		log(mark('S1-1 同 id 两次 useStore 同一实例', a == b, 'a===b'))

		// S1-2 同 id 重复 defineStore：幂等（控制台同步输出警告）
		const dupUse = defineStore<CounterStore>('counter', (): CounterStore => {
			const n: Ref<number> = ref(99)
			const nName: Ref<string> = ref('dup')
			const noop0 = (): void => {}
			const noop1 = (n: string): void => {}
			return { count: n, name: nName, doubleCount: a.doubleCount, increment: noop0, setName: noop1, reset: noop0 } as CounterStore
		})
		const c = dupUse()
		log(mark('S1-2 同 id 重复 defineStore 幂等', c == a, '返回既有实例（控制台有警告）'))

		// S1-3 不同 id 相互独立
		const u = useUserStore()
		log(mark('S1-3 不同 id 各自独立', a != u, 'counter 与 user 为不同实例'))
	}

	onMounted((): void => {
		run()
	})
</script>
