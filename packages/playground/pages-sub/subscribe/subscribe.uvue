<template>
	<view class="page">
		<demo-navbar title="状态订阅" subtitle="Subscribe" />
		<demo-bridge />
		<scroll-view class="page-body" :scroll-y="true">
		<view class="container">
			<view class="card">
				<text class="card-title">功能说明</text>
				<text class="card-desc">$subscribe 订阅状态变更（0.2.0 由 PiniaStoreBase 提供）：$patch / $reset / $save 触发，回调收到 type 与 _serialize 快照，返回取消函数。注意：direct 修改 state（含 increment 等 action 直接改字段）不触发——需要快照/落盘的场景显式调用 $save()。进入页面自动运行。</text>
			</view>

			<view class="card">
				<text class="card-line">count: {{ counterStore.state.count }}</text>
				<text class="card-line">已触发次数: {{ fired }}</text>
			</view>

			<text class="section">用例</text>
			<view class="row">
				<button class="row-btn" size="mini" @click="run">运行（订阅→触发→取消→复验）</button>
				<button class="row-btn" size="mini" @click="patchInc">$patch count+1（观察订阅）</button>
			</view>

			<view class="logs">
				<view class="logs-head">
					<text class="logs-title">运行日志（console 同步输出 [verify] 前缀日志）</text>
					<button class="row-btn" size="mini" @click="clearLog">清空</button>
				</view>
				<text v-for="(line, index) in logs" :key="index" class="log">{{ line }}</text>
			</view>
		</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	// 页面声明宏：编译期由 ux-router vite 插件剥离，驱动 pages.json 与路由表生成
	defineUniPage({
		title: '状态订阅',
		name: 'subscribe'
	})
	import { ref } from 'vue'
	import { useCounterStore } from '@/stores/counter.uts'
	import { markEq } from '@/common/test-utils.uts'

	const counterStore = useCounterStore()

	const fired = ref(0)
	const logs = ref<Array<string>>([])

	function log(msg: string): void {
		const line = '[verify] ' + msg
		logs.value.unshift(line)
		if (logs.value.length > 200) {
			logs.value.splice(200, logs.value.length - 200)
		}
		console.log(line)
	}

	function clearLog(): void {
		logs.value.splice(0, logs.value.length)
	}

	let stop: (() => void) | null = null

	const patchInc = (): void => {
		counterStore.$patch({ count: counterStore.state.count + 1 } as UTSJSONObject)
	}

	/** U1 状态订阅 */
	function run(): void {
		// 重复运行前先释放旧订阅（const 中转，避免闭包可变变量的 smart cast 限制）
		const old = stop
		if (old != null) {
			old()
			stop = null
		}
		fired.value = 0

		// U1-1 注册整体订阅（$patch/$reset/$save 触发）
		stop = counterStore.$subscribe((type: string, state: UTSJSONObject): void => {
			fired.value++
			log('U1 订阅触发 type=' + type + ' 当前 count=' + counterStore.state.count.toString() + '（第 ' + fired.value.toString() + ' 次）')
		})
		log('U1-1 $subscribe 已注册（$patch/$reset/$save 触发；direct 修改不触发）')

		// U1-2 $patch 触发一次（同步分发，partial 经 _hydrate 装载）
		const next = counterStore.state.count + 1
		counterStore.$patch({ count: next } as UTSJSONObject)
		log(markEq('U1-2 $patch 后回调触发', fired.value, 1))
		log(markEq('U1-2b $patch 装载 count', counterStore.state.count, next))

		// U1-3 取消订阅后不再触发
		const s = stop
		if (s != null) {
			s()
			stop = null
		}
		counterStore.$patch({ count: counterStore.state.count + 1 } as UTSJSONObject)
		log(markEq('U1-3 取消后不再触发', fired.value, 1))
		log('说明：increment 等 action 为 direct 修改，不触发 $subscribe（UTS 无全局订阅钩子）')
	}

	onMounted((): void => {
		run()
	})
</script>
