<template>
	<view class="page">
		<demo-navbar title="状态订阅" subtitle="Subscribe" />
		<demo-bridge />
		<scroll-view class="page-body" :scroll-y="true">
		<view class="container">
			<view class="card">
				<text class="card-title">功能说明</text>
				<text class="card-desc">状态订阅使用字段级 watch（整体 $subscribe 已裁掉：deep watch 在 Android 端对 RefImpl 字段不触发，双端实测不一致）。watch 返回 stop 函数，调用后不再触发。进入页面自动运行。</text>
			</view>

			<view class="card">
				<text class="card-line">count: {{ count }}</text>
				<text class="card-line">已触发次数: {{ fired }}</text>
			</view>

			<text class="section">用例</text>
			<view class="row">
				<button class="row-btn" size="mini" @click="run">运行（订阅→触发→取消→复验）</button>
				<button class="row-btn" size="mini" @click="counterStore.increment">increment</button>
			</view>

			<view class="logs">
				<view class="logs-head">
					<text class="logs-title">运行日志（console 同步输出 [verify] 前缀日志）</text>
					<button class="row-btn" size="mini" @click="clearLog">清空</button>
				</view>
				<text v-for="(line, index) in logs" :key="index" class="log">{{ line }}</text>
			</view>
		</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	// 页面声明宏：编译期由 ux-router vite 插件剥离，驱动 pages.json 与路由表生成
	defineUniPage({
		title: '状态订阅',
		name: 'subscribe'
	})
	import { ref } from 'vue'
	import { storeToRefs } from '@/uni_modules/ux-pinia'
	import { useCounterStore } from '@/stores/counter.uts'
	import { mark, markEq } from '@/common/test-utils.uts'

	const counterStore = useCounterStore()
	const { count } = storeToRefs(counterStore)

	const fired = ref(0)
	const logs = ref<Array<string>>([])

	function log(msg: string): void {
		const line = '[verify] ' + msg
		logs.value.unshift(line)
		if (logs.value.length > 200) {
			logs.value.splice(200, logs.value.length - 200)
		}
		console.log(line)
	}

	function clearLog(): void {
		logs.value.splice(0, logs.value.length)
	}

	let stop: (() => void) | null = null

	/** U1 状态订阅 */
	function run(): void {
		// 重复运行前先释放旧订阅（const 中转，避免闭包可变变量的 smart cast 限制）
		const old = stop
		if (old != null) {
			old()
			stop = null
		}
		fired.value = 0

		// U1-1 注册字段级订阅
		stop = watch(count, (newVal: number, oldVal: number): void => {
			fired.value++
			log('U1 watch 触发：' + oldVal.toString() + ' -> ' + newVal.toString() + '（第 ' + fired.value.toString() + ' 次）')
		})
		log('U1-1 字段级 watch 已注册')

		// U1-2 触发一次
		counterStore.increment()
		setTimeout((): void => {
			log(markEq('U1-2 修改后回调触发', fired.value, 1))

			// U1-3 stop 取消后不再触发
			const s = stop
			if (s != null) {
				s()
				stop = null
			}
			counterStore.increment()
			setTimeout((): void => {
				log(markEq('U1-3 stop 后不再触发', fired.value, 1))
			}, 200)
		}, 200)
	}

	onMounted((): void => {
		run()
	})
</script>

