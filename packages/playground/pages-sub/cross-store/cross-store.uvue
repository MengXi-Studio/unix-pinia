<template>
	<view class="page">
		<demo-navbar title="跨 store 依赖" subtitle="Cross Store" />
		<demo-bridge />
		<scroll-view class="page-body" :scroll-y="true">
		<view class="container">
			<view class="card">
				<text class="card-title">功能说明</text>
				<text class="card-desc">store method 内直接调用对方 useStore 即可组合 store（注册表保证单例）；推荐在 action 内跨 store 修改，getter 内避免跨 store 循环依赖。进入页面自动运行。</text>
			</view>

			<view class="card">
				<text class="card-line">counter.count: {{ counterStore.state.count }}</text>
				<text class="card-line">user.score: {{ userStore.state.score }}</text>
			</view>

			<text class="section">用例</text>
			<view class="row">
				<button class="row-btn" size="mini" @click="run">重新运行</button>
				<button class="row-btn" size="mini" @click="userStore.addScoreFromCount()">addScoreFromCount</button>
			</view>

			<view class="logs">
				<view class="logs-head">
					<text class="logs-title">运行日志（console 同步输出 [verify] 前缀日志）</text>
					<button class="row-btn" size="mini" @click="clearLog">清空</button>
				</view>
				<text v-for="(line, index) in logs" :key="index" class="log">{{ line }}</text>
			</view>
		</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	// 页面声明宏：编译期由 ux-router vite 插件剥离，驱动 pages.json 与路由表生成
	defineUniPage({
		title: '跨 store 依赖',
		name: 'cross-store'
	})
	import { ref } from 'vue'
	import { useCounterStore } from '@/stores/counter.uts'
	import { useUserStore } from '@/stores/user.uts'
	import { mark, markEq } from '@/common/test-utils.uts'

	const counterStore = useCounterStore()
	const userStore = useUserStore()

	const logs = ref<Array<string>>([])

	function log(msg: string): void {
		const line = '[verify] ' + msg
		logs.value.unshift(line)
		if (logs.value.length > 200) {
			logs.value.splice(200, logs.value.length - 200)
		}
		console.log(line)
	}

	function clearLog(): void {
		logs.value.splice(0, logs.value.length)
	}

	/** C1 跨 store 依赖 */
	function run(): void {
		// 复位 user，保证重新运行断言可重复
		userStore.reset()
		// C1-1 counter 的 action 修改后，user 的 action 读取到最新值
		counterStore.reset()
		counterStore.increment()
		counterStore.increment()
		const before = counterStore.state.count
		userStore.addScoreFromCount()
		log(markEq('C1-1 user 读取 counter 最新值并累加 score', userStore.state.score, before))

		// C1-2 再次调用持续累加（跨 store 状态持久）
		userStore.addScoreFromCount()
		log(markEq('C1-2 再次调用累加', userStore.state.score, before * 2))

		// C1-3 双 store 实例共存
		log(mark('C1-3 双 store 独立共存', counterStore.$id != userStore.$id, "id: '" + counterStore.$id + "' != '" + userStore.$id + "'"))
	}

	onMounted((): void => {
		run()
	})
</script>

