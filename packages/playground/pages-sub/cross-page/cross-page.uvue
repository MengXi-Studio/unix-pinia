<template>
	<view class="page">
		<demo-navbar title="跨页面共享（写入）" subtitle="Cross Page" />
		<demo-bridge />
		<scroll-view class="page-body" :scroll-y="true">
		<view class="container">
			<view class="card">
				<text class="card-title">跨页面共享 · 写入方</text>
				<text class="card-desc">本页修改 counter 后跳转断言页：断言页 useStore 拿到的是注册表中的同一实例，count 应与离开本页时一致。返回后本页视图随断言页的修改联动。</text>
			</view>

			<view class="card">
				<text class="card-line">当前 count: {{ counterStore.state.count }}</text>
				<text class="card-line">doubleCount: {{ counterStore.doubleCount }}</text>
			</view>

			<view class="row">
				<button class="row-btn" size="mini" @click="counterStore.increment()">increment</button>
				<button class="row-btn" size="mini" @click="counterStore.reset()">reset</button>
			</view>

			<view class="row">
				<button class="row-btn" size="mini" @click="goVerify">跳转断言页（先 increment 再比对）</button>
			</view>
		</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	// 页面声明宏：编译期由 ux-router vite 插件剥离，驱动 pages.json 与路由表生成
	defineUniPage({
		title: '跨页面共享（写入）',
		name: 'cross-page'
	})
	import { useCounterStore } from '@/stores/counter.uts'
	import { setT1Expected } from '@/stores/testContext.uts'

	const counterStore = useCounterStore()

	const goVerify = (): void => {
		counterStore.increment()
		// T1 跨页面断言：记录离开本页时的状态，断言页比对（证明同一实例）
		setT1Expected(counterStore.state.count)
		console.log('[verify] T1 leave cross-page, count = ' + counterStore.state.count.toString())
		uni.navigateTo({ url: '/pages-sub/cross-verify/cross-verify' })
	}
</script>

