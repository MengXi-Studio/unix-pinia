<template>
	<scroll-view style="flex:1">
		<view class="container">
			<view class="intro">
				<text class="intro-title">跨页面共享 · 写入方</text>
				<text class="intro-text">本页修改 counter 后跳转断言页：断言页 useStore 拿到的是注册表中的同一实例，count 应与离开本页时一致。返回后本页视图随断言页的修改联动。</text>
			</view>

			<view class="card">
				<text class="card-line">当前 count: {{ count }}</text>
				<text class="card-line">doubleCount: {{ doubleCount }}</text>
			</view>

			<view class="row">
				<button size="mini" @click="counterStore.increment">increment</button>
				<button size="mini" @click="counterStore.reset">reset</button>
			</view>

			<view class="row">
				<button size="mini" @click="goVerify">跳转断言页（先 increment 再比对）</button>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { storeToRefs } from '@/uni_modules/ux-pinia'
	import { useCounterStore } from '@/stores/counter.uts'
	import { setT1Expected } from '@/stores/testContext.uts'

	const counterStore = useCounterStore()
	const { count, doubleCount } = storeToRefs(counterStore)

	const goVerify = (): void => {
		counterStore.increment()
		// T1 跨页面断言：记录离开本页时的状态，断言页比对（证明同一实例）
		setT1Expected(counterStore.count.value)
		console.log('[verify] T1 leave cross-page, count = ' + counterStore.count.value.toString())
		uni.navigateTo({ url: '/pages-sub/cross-verify/cross-verify' })
	}
</script>

<style>
	.card {
		flex-direction: column;
		background-color: #ffffff;
		border-radius: 16rpx;
		padding: 24rpx;
		margin-bottom: 24rpx;
	}

	.card-line {
		font-size: 28rpx;
		color: #1a1a1a;
		margin-bottom: 8rpx;
	}
</style>
