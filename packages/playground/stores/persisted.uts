import { ref } from 'vue'
import type { Ref } from 'vue'
import { defineStore } from '@/uni_modules/ux-pinia'
import { persistedRef } from './persist-helper.uts'

/**
 * persisted store：持久化演示（unix-pinia-persist 生态示范）
 *
 * - pvCount：持久化字段（persistedRef 声明，存储键 'persist-demo.count'，默认 0）
 * - pvName：持久化字段（存储键 'persist-demo.name'，默认 'pinia'）
 * - tempValue：普通内存字段（对照项，杀进程后回默认）
 */
export type PersistedStore = {
	pvCount: Ref<number>,
	pvName: Ref<string>,
	tempValue: Ref<string>,
	add: () => void,
	setName: (n: string) => void,
	setTemp: (s: string) => void,
	reset: () => void
}

export const usePersistedStore = defineStore<PersistedStore>('persist-demo', (): PersistedStore => {
	// 每字段一行约定：声明即持久化（恢复 + watch 落盘在 persistedRef 内组合插件存储原语）
	const pvCount: Ref<number> = persistedRef('persist-demo', 'count', 0)
	const pvName: Ref<string> = persistedRef('persist-demo', 'name', 'pinia')
	const tempValue: Ref<string> = ref('temp-default')
	const add = (): void => {
		pvCount.value++
	}
	const setName = (n: string): void => {
		pvName.value = n
	}
	const setTemp = (s: string): void => {
		tempValue.value = s
	}
	const reset = (): void => {
		pvCount.value = 0
		pvName.value = 'pinia'
		tempValue.value = 'temp-default'
	}
	return { pvCount: pvCount, pvName: pvName, tempValue: tempValue, add: add, setName: setName, setTemp: setTemp, reset: reset } as PersistedStore
})
