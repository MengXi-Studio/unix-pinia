/**
 * persisted store：持久化演示（0.3.0 class 式架构 + 内置持久化插件）
 *
 * 持久化契约（Template Method）：
 * - _serialize()：$patch/$reset/$save 触发落盘时的 state 快照（tempValue 故意不含——对照项）
 * - _hydrate(data)：store 创建时插件读存储回填（字段级判空，损坏数据天然回退初始值）
 * - tempValue 为普通内存字段（对照项，杀进程后回默认）
 */
import { reactive } from 'vue'
import { defineStore, PiniaStoreBase } from '@/uni_modules/ux-pinia'

export type PersistedState = {
	pvCount: number
	pvName: string
	tempValue: string
}

export class PersistedStore extends PiniaStoreBase {
	state: PersistedState = reactive<PersistedState>({ pvCount: 0, pvName: 'pinia', tempValue: 'temp-default' })

	constructor() {
		super()
		this.bindState(this.state)
	}

	add(): void {
		this.state.pvCount++
	}

	setName(n: string): void {
		this.state.pvName = n
	}

	setTemp(s: string): void {
		this.state.tempValue = s
	}

	reset(): void {
		this.state.pvCount = 0
		this.state.pvName = 'pinia'
		this.state.tempValue = 'temp-default'
	}

	override _doReset(): void {
		this.reset()
	}

	// 落盘快照：tempValue 不含（内存字段对照）
	override _serialize(): UTSJSONObject {
		return { pvCount: this.state.pvCount, pvName: this.state.pvName } as UTSJSONObject
	}

	// 恢复回填：字段级判空（存储损坏 / 字段缺失 → 保留初始值）
	override _hydrate(data: UTSJSONObject): void {
		if (data['pvCount'] != null) {
			this.state.pvCount = data['pvCount'] as number
		}
		if (data['pvName'] != null) {
			this.state.pvName = data['pvName'] as string
		}
	}
}

export const usePersistedStore = defineStore<PersistedStore>('persist-demo', (): PersistedStore => new PersistedStore())
