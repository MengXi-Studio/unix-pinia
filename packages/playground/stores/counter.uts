import type { ComputedRef } from 'vue'
import { defineStore } from '@/uni_modules/ux-pinia'

/**
 * counter store：基础示例（state / getter / action / 跨页面共享演示）
 *
 * 类型导入规范：ComputedRef 编译器不全局注入，必须显式导入；Ref 建议统一显式导入。
 */
export type CounterStore = {
  count: Ref<number>,
  name: Ref<string>,
  doubleCount: ComputedRef<number>,
  increment: () => void,
  setName: (n: string) => void,
  reset: () => void
}

export const useCounterStore = defineStore<CounterStore>('counter', (): CounterStore => {
  // state
  const count: Ref<number> = ref(0)
  const name: Ref<string> = ref('pinia')
  // getter
  const doubleCount: ComputedRef<number> = computed((): number => {
    return count.value * 2
  })
  // action（UTS 函数声明不能作值传递，必须箭头函数表达式）
  const increment = (): void => {
    count.value++
  }
  const setName = (n: string): void => {
    name.value = n
  }
  const reset = (): void => {
    count.value = 0
    name.value = 'pinia'
  }
  return { count: count, name: name, doubleCount: doubleCount, increment: increment, setName: setName, reset: reset } as CounterStore
})
