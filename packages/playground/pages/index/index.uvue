<template>
	<view class="page">
		<scroll-view class="page-body" :scroll-y="true">
			<view class="container">
				<!-- 品牌区 -->
				<view class="brand">
					<view class="brand-row">
						<text class="brand-name">unix-pinia</text>
						<text class="brand-version">v0.1.0</text>
					</view>
					<text class="brand-slogan">为 uni-app x 提供 Pinia 风格的状态管理</text>
				</view>

				<!-- 搜索框 -->
				<view class="search">
					<text class="search-icon">⌕</text>
					<input
						class="search-input"
						:value="keyword"
						placeholder="搜索功能"
						placeholder-class="search-placeholder"
						@input="onSearchInput"
					/>
				</view>

				<!-- 分组导航 -->
				<view v-for="group in filteredGroups" :key="group.title" class="group">
					<text class="group-title">{{ group.title }}</text>
					<view class="group-card">
						<view
							v-for="(item, i) in group.items"
							:key="item.name"
							:class="i < group.items.length - 1 ? 'item item-line' : 'item'"
							@click="goDemo(item.name)"
						>
							<view class="item-main">
								<view class="item-head">
									<text class="item-zh">{{ item.zhName }}</text>
									<text class="item-en">{{ item.enName }}</text>
								</view>
								<text class="item-desc">{{ item.desc }}</text>
							</view>
							<text class="item-arrow">›</text>
						</view>
					</view>
				</view>

				<!-- 搜索无结果 -->
				<view v-if="filteredGroups.length == 0" class="empty">
					<text class="empty-text">未找到与「{{ keyword }}」匹配的功能</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	// 页面声明宏：编译期由 ux-router vite 插件剥离，驱动 pages.json 与路由表生成
	defineUniPage({
		title: 'unix-pinia',
		name: 'home'
	})
	import { ref } from 'vue'
	import { useRouter } from '@/uni_modules/ux-router/utssdk/index.uts'
	import type { RawLocation } from '@/uni_modules/ux-router/utssdk/index.uts'
	import { demoGroups } from './demo-pages.uts'
	import type { DemoPage, DemoGroup } from './demo-pages.uts'

	const router = useRouter()

	/** 搜索关键字（空串 = 不过滤） */
	const keyword = ref('')

	/** 按关键字过滤分组：中文名 / 英文标识模糊匹配，过滤后为空的分组整体剔除 */
	const filteredGroups = computed((): DemoGroup[] => {
		const kw = keyword.value.trim().toLowerCase()
		if (kw.length == 0) {
			return demoGroups
		}
		const result: DemoGroup[] = []
		demoGroups.forEach((group: DemoGroup) => {
			const items: DemoPage[] = []
			group.items.forEach((item: DemoPage) => {
				if (item.zhName.indexOf(kw) != -1 || item.enName.toLowerCase().indexOf(kw) != -1) {
					items.push(item)
				}
			})
			if (items.length > 0) {
				result.push({ title: group.title, items: items })
			}
		})
		return result
	})

	/** input 输入回调：同步关键字触发过滤 */
	const onSearchInput = (e: InputEvent) => {
		keyword.value = e.detail.value
	}

	/** 按名导航到功能演示页 */
	const goDemo = (name: string) => {
		router.push({ name: name } as RawLocation)
	}
</script>

<style>
	/* 品牌区 */
	.brand {
		flex-direction: column;
		padding: 32rpx 8rpx 24rpx 8rpx;
	}

	.brand-row {
		flex-direction: row;
		align-items: center;
	}

	.brand-name {
		font-size: 48rpx;
		font-weight: bold;
		color: #1a1a1a;
	}

	.brand-version {
		font-size: 20rpx;
		color: #999999;
		background-color: #f2f3f5;
		border-radius: 8rpx;
		padding: 4rpx 12rpx;
		margin-left: 16rpx;
	}

	.brand-slogan {
		font-size: 24rpx;
		color: #666666;
		margin-top: 12rpx;
	}

	/* 搜索框 */
	.search {
		flex-direction: row;
		align-items: center;
		height: 72rpx;
		background-color: #f2f3f5;
		border-radius: 36rpx;
		padding: 0 24rpx;
		margin-bottom: 24rpx;
	}

	.search-icon {
		font-size: 30rpx;
		color: #999999;
	}

	.search-input {
		flex: 1;
		font-size: 26rpx;
		color: #1a1a1a;
		margin-left: 12rpx;
		height: 72rpx;
		line-height: 72rpx;
	}

	.search-placeholder {
		color: #c8c9cc;
		font-size: 26rpx;
	}

	/* 分组导航 */
	.group {
		flex-direction: column;
		margin-bottom: 24rpx;
	}

	.group-title {
		font-size: 26rpx;
		font-weight: bold;
		color: #666666;
		margin: 8rpx 8rpx 12rpx 8rpx;
	}

	.group-card {
		flex-direction: column;
		background-color: #ffffff;
		border-radius: 16rpx;
	}

	.item {
		flex-direction: row;
		align-items: center;
		padding: 24rpx;
	}

	.item-line {
		border-bottom: 1px solid #f5f5f5;
	}

	.item-main {
		flex: 1;
		flex-direction: column;
		margin-right: 16rpx;
	}

	.item-head {
		flex-direction: row;
		align-items: center;
	}

	.item-zh {
		font-size: 28rpx;
		font-weight: bold;
		color: #1a1a1a;
	}

	.item-en {
		font-size: 22rpx;
		color: #999999;
		margin-left: 12rpx;
	}

	.item-desc {
		font-size: 22rpx;
		color: #999999;
		margin-top: 8rpx;
	}

	.item-arrow {
		font-size: 32rpx;
		color: #c8c9cc;
	}

	/* 搜索无结果 */
	.empty {
		flex-direction: column;
		align-items: center;
		padding: 80rpx 0;
	}

	.empty-text {
		font-size: 24rpx;
		color: #999999;
	}
</style>
