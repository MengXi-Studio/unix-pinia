/**
 * 功能演示条目数据表（首页分组导航的唯一数据源）
 *
 * 新增功能页时在对应分组的 items 中登记一条即可，
 * 首页分组列表与搜索过滤自动生效；演示页路由需另行在
 * 页面 defineUniPage 与 pages.json 中登记。
 */

/** 功能演示条目 */
export type DemoPage = {
	/** 路由名（router.push 按名导航，须与 defineUniPage 的 name 一致） */
	name: string
	/** 中文名 */
	zhName: string
	/** 英文标识（与页面目录名一致，兼作 navbar 副标题） */
	enName: string
	/** 一句话简介 */
	desc: string
}

/** 演示分组 */
export type DemoGroup = {
	/** 分组标题 */
	title: string
	/** 组内功能条目 */
	items: DemoPage[]
}

/**
 * 功能演示分组表（分组体系：基础能力 / 单例与组合 / 实例 API 与插件）
 */
export const demoGroups: DemoGroup[] = [
	{
