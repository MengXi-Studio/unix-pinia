<template>
  <scroll-view class="page">
    <view class="card">
      <text class="title">T1 跨页面单例验证</text>
      <text class="item">second 页实时读取 count: {{ count }}</text>
      <text class="item">second 页实时读取 doubleCount: {{ doubleCount }}</text>
      <text class="item">{{ t1Result }}</text>
      <text class="item">（count 应与离开首页时一致，且 doubleCount = count × 2）</text>
    </view>
    <button class="btn" @click="onInc">second 页内 increment（观察返回首页后联动）</button>
    <button class="btn" @click="onBack">返回首页</button>
  </scroll-view>
</template>

<script setup lang="uts">
  import { useCounterStore } from '@/stores/counter.uts'
  import { storeToRefs } from '@/uni_modules/ux-pinia'
  import { getT1Expected } from '@/stores/testContext.uts'

  const secondStore = useCounterStore()
  const { count, doubleCount } = storeToRefs(secondStore)

  const t1Result = ref('T1 断言: 待判定')

  onMounted((): void => {
    const expected = getT1Expected()
    const actual = secondStore.count.value
    const pass = actual == expected && secondStore.doubleCount.value == actual * 2
    t1Result.value = 'T1 断言: ' + (pass ? 'pass（同一实例，状态与首页一致）' : 'fail（actual=' + actual.toString() + ', expected=' + expected.toString() + '）')
    console.log('[verify] T1 second page count =', actual, 'expected =', expected, '=>', pass ? 'PASS' : 'FAIL')
    // 演示跨页面修改：返回首页后首页视图应联动
    secondStore.increment()
    console.log('[verify] T1 second page increment ->', secondStore.count.value)
  })

  const onInc = (): void => {
    secondStore.increment()
  }

  const onBack = (): void => {
    uni.navigateBack()
  }
</script>
